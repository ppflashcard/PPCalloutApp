{
  "name": "salesforce-callout",
  "version": "1.0.0",
  "description": "Lightweight Salesforce REST API callout client",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --watch public --ext ts,js,html,css --exec tsx src/server.ts",
    "ui": "npm run dev",
    "callout": "tsx src/index.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": ["salesforce", "rest", "callout"],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "nodemon": "^3.1.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
