# Connected App credentials (optional for Username & Password tab when SOAP is disabled; required for CLI)
# When set here, the UI hides Client ID/Secret fields and uses these automatically.
SF_CLIENT_ID=your_connected_app_consumer_key
SF_CLIENT_SECRET=your_connected_app_consumer_secret

# Login URL: https://login.salesforce.com (prod) or https://test.salesforce.com (sandbox)
SF_LOGIN_URL=https://login.salesforce.com

# Username-Password flow (server-to-server; append security token to password if required)
SF_USERNAME=your_user@example.com
SF_PASSWORD=your_password_and_security_token

# API version (e.g. v59.0)
SF_API_VERSION=v59.0

# JWT Bearer login (optional — powers the JWT Login tab without entering keys in the UI)
# Use the integration user's username as SF_USERNAME and the matching certificate private key.
# SF_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Or point to a key file on the server:
# SF_JWT_PRIVATE_KEY_PATH=./certs/server.key

# Optional: exact SSO callback URL if auto-detection fails on your host (no trailing slash)
# OAUTH_CALLBACK_URL=https://your-app.vercel.app/api/oauth/callback

# Optional: override endpoint path for the example callout (relative to /services/data/{version}/)
# SF_CALLOUT_PATH=/sobjects/Account/describe
